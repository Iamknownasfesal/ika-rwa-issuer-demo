# ── Solana / Ika (defaults come from deployments/devnet.json) ──
# RPC_URL=https://api.devnet.solana.com
# GRPC_URL=pre-alpha-dev-1.ika.ika-network.net:443

# ── Executor delivery ──
# DELIVER=mock                     # mock | evm  (evm = real MintController calls on the EVM testnets)

# ── EVM testnets (pnpm deploy:evm, executor deliver=evm) ──
# EVM_DEPLOYER_KEY=0x…             # deploys MintController; generated into keys/evm-deployer.json when unset
# EVM_RELAYER_KEY=0x…              # pays gas for mint/burn deliveries; defaults to the deployer key
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# EVM_DEPLOYMENTS_FILE=deployments/evm.json

# ── Sui (testnet) ──────────────────────────────────────────────────────────
# Written by `pnpm deploy:sui`; the executor delivers Sui legs when this file exists and DELIVER=sui (or `--deliver sui`).
SUI_DEPLOYMENT_FILE=deployments/sui.json
# Relayer / deployer key: { "secretKey": "suiprivkey1…" }. Generated + faucet-funded by deploy-sui.ts.
SUI_DEPLOYER_KEY_FILE=keys/sui-deployer.json
# Optional RPC override (default: https://fullnode.testnet.sui.io:443)
# SUI_RPC_URL=
